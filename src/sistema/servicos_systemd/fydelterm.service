[Unit]
Description=Terminal Oficial Fydelistechos OS (Modo Quiosque)
Documentation=https://fydelistechos.com.br
After=systemd-user-sessions.service getty.target local-fs.target systemd-logind.service
Conflicts=getty@tty1.service

[Service]
Type=idle
User=usuario
Group=fydel-users
# Dá ao utilizador comum a permissão necessária para gerir os nós da TTY1 e PTMX
SupplementaryGroups=tty

ExecStart=/usr/local/bin/fydelterm
Restart=always
RestartSec=3

# Garante o controlo absoluto do teclado e ecrã da TTY1
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# Variáveis ambientais cruciais para as cores e suporte aos Emojis/Caracteres Especiais
Environment=TERM=xterm-256color LANG=pt_BR.UTF-8 LC_ALL=pt_BR.UTF-8

[Install]
WantedBy=multi-user.target
