use v5.20;
use strict;
use warnings;
use feature qw(signatures postderef);
no warnings qw(experimental::signatures experimental::postderef);

use Cwd qw(abs_path);
use File::Basename qw(dirname);
use lib dirname(abs_path($0)) . '/lib';

use FydelisAI;
use FydelisAI::Config;
use FydelisAI::Logger;
use FydelisAI::CLI;

# ── Graceful shutdown ──────────────────────────────────
our $SHUTDOWN = 0;
$SIG{INT}  = sub { $SHUTDOWN = 1; print "\n⚠️  Encerrando...\n"; };
$SIG{TERM} = sub { $SHUTDOWN = 1; };

sub main {
    my $cli  = FydelisAI::CLI->new();
    my $conf = $cli->parse_args(\@ARGV) or return 1;

    my $logger = FydelisAI::Logger->new(
        level   => $conf->verbose ? 'DEBUG' : 'INFO',
        logfile => $conf->logfile,
    );

    my $target = $conf->target // '';

    my $fydelis = FydelisAI->new(
        config => $conf,
        logger => $logger,
        target => $target,
    );

    # ── Ações ──────────────────────────────────────────

    # Ping / Status
    if ($conf->action && $conf->action eq 'ping') {
        if ($fydelis->ping()) {
            $logger->info("✅ Ollama está rodando em %s", $conf->ollama_url);
        } else {
            $logger->error("❌ Ollama não está respondendo em %s", $conf->ollama_url);
        }
        return 0;
    }

    # Listar modelos
    if ($conf->action && $conf->action eq 'models') {
        my $models = $fydelis->list_models();
        $logger->info("Modelos disponíveis:");
        for my $m ($models->@*) {
            $logger->info("  %s (%s)", $m->{name},
                $m->{size} > 1_000_000_000
                    ? sprintf("%.1f GB", $m->{size} / 1_000_000_000)
                    : sprintf("%.1f MB", $m->{size} / 1_000_000)
            );
        }
        return 0;
    }

    # Limpar sessão
    if ($conf->action && $conf->action eq 'clear-session') {
        $fydelis->clear_session();
        return 0;
    }

    # Cache stats
    if ($conf->action && $conf->action eq 'cache-stats') {
        my $stats = $fydelis->cache_stats();
        $logger->info("Cache: %d arquivos, %s", $stats->{files}, $stats->{size_str});
        return 0;
    }

    # Limpar cache
    if ($conf->action && $conf->action eq 'clean-cache') {
        $fydelis->clean_cache();
        return 0;
    }

    # ── Modo interativo ───────────────────────────────
    if ($conf->action && $conf->action eq 'interactive') {
        $logger->info("Modo interativo. Digite 'exit' ou 'quit' para sair.");
        $logger->info("Comandos especiais: /clear (limpar sessão), /models, /ping, /cache\n");

        while (1) {
            last if $SHUTDOWN;
            print "\n\033[1;32mfydelis-ai>\033[0m ";
            my $input = <STDIN>;
            last unless defined $input;
            chomp $input;
            last if $input =~ /^(exit|quit|q)$/i;

            # Comandos internos
            if ($input =~ /^\/clear/) {
                $fydelis->clear_session();
                print "✅ Sessão limpa.\n";
                next;
            }

            if ($input =~ /^\/models/) {
                my $models = $fydelis->list_models();
                print "Modelos disponíveis:\n";
                for my $m ($models->@*) {
                    print "  $m->{name}\n";
                }
                next;
            }

            if ($input =~ /^\/ping/) {
                my $ok = $fydelis->ping();
                print $ok ? "✅ Ollama OK\n" : "❌ Ollama offline\n";
                next;
            }

            if ($input =~ /^\/cache/) {
                my $stats = $fydelis->cache_stats();
                print "Cache: $stats->{files} arquivos, $stats->{size_str}\n";
                next;
            }

            next if $input =~ /^\s*$/;

            # Perguntar à IA
            my $response = $fydelis->ask($input, $conf->template);
        }

        return 0;
    }

    # ── Executar comando e analisar ──────────────────
    if ($conf->action && $conf->action eq 'exec') {
        unless ($conf->command) {
            $logger->error("Comando não fornecido. Use --command ou -c.");
            return 1;
        }

        my $result = $fydelis->run_and_analyze($conf->command, $conf->timeout);
        $logger->output("\n%s", $result);
        return 0;
    }

    # ── Sugerir comando ──────────────────────────────
    if ($conf->action && $conf->action eq 'suggest') {
        my $context = $conf->query || "scaneie o alvo $target";
        my $suggestion = $fydelis->suggest_command($context);

        if ($suggestion->{command}) {
            $logger->info("Comando sugerido:\n  \033[1;33m%s\033[0m", $suggestion->{command});
        }

        $logger->output("\n%s", $suggestion->{analysis});
        return 0;
    }

    # ── Analisar output de arquivo ───────────────────
    if ($conf->action && $conf->action eq 'analyze') {
        unless ($conf->file) {
            $logger->error("Arquivo não fornecido. Use --file ou -f.");
            return 1;
        }

        my $analysis = $fydelis->analyze_output($conf->file, $conf->tool_type);
        $logger->output("\n%s", $analysis);
        return 0;
    }

    # ── Pergunta livre (modo padrão) ─────────────────
    if ($conf->query) {
        my $response = $fydelis->ask($conf->query, $conf->template);
        unless ($conf->ollama_stream) {
            $logger->output("\n%s", $response);
        }
        return 0;
    }

    # ── Se nada foi especificado, mostrar ajuda ─────
    $cli->show_help();
    return 1;
}

exit main();